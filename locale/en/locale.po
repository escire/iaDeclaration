msgstr "You must register the declaration before saving. Use the 'Create declaration', 'Register no-AI declaration', or 'Find declaration' button."

msgid "plugins.generic.aiDeclaration.error.noApiKey"
msgstr "No API Key configured. Please configure the plugin settings first."

msgid "plugins.generic.aiDeclaration.error.apiUnavailable"
msgstr "The declaration server is unavailable"

msgid "plugins.generic.aiDeclaration.error.apiUnavailableHint"
msgstr "After several failed attempts, you may continue the submission. An editor will register the declaration later from the editorial panel."

msgid "plugins.generic.aiDeclaration.form.action.continueWithoutDeclaration"
msgstr "Continue without declaration (editor will register it)"

msgid "plugins.generic.aiDeclaration.form.bypass.pending"
