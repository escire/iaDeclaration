msgstr "Debe registrar la declaración antes de guardar. Use el botón 'Crear declaración', 'Registrar declaración sin IA' o 'Buscar declaración'."

msgid "plugins.generic.aiDeclaration.error.noApiKey"
msgstr "No hay API Key configurada. Configure el plugin antes de continuar."

msgid "plugins.generic.aiDeclaration.error.apiUnavailable"
msgstr "El servidor de declaraciones no está disponible"

msgid "plugins.generic.aiDeclaration.error.apiUnavailableHint"
msgstr "Después de varios intentos fallidos, puede continuar el envío. Un editor revisará y registrará la declaración más adelante desde el panel editorial."

msgid "plugins.generic.aiDeclaration.form.action.continueWithoutDeclaration"
msgstr "Continuar sin declaración (el editor la registrará)"

msgid "plugins.generic.aiDeclaration.form.bypass.pending"
msgstr "Pendiente: el editor registrará la declaración"

msgid "plugins.generic.aiDeclaration.workflow.bypassNotice"
msgstr "Esta publicación tiene una declaración pendiente de registro. El servicio de declaraciones no estaba disponible durante el envío. Por favor, registre la declaración a continuación."

